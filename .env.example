# Copy to .env in repo root and/or frontend/.env — never commit real secrets.

# PostgreSQL (Prisma + docker-compose)
# Use a full URL here — standard dotenv does NOT expand ${DB_USER} inside DATABASE_URL.
DATABASE_URL=postgresql://LTIdbUser:your_password@localhost:5432/LTIdb
DB_USER=LTIdbUser
DB_PASSWORD=your_password
DB_NAME=LTIdb
DB_PORT=5432

# Backend API
PORT=3010
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Create React App)
REACT_APP_API_URL=http://localhost:3010
